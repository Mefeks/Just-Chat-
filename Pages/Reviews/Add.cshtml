@page
@model JustChatWeb.Pages.Reviews.AddModel
@{
    ViewData["Title"] = "Оставить отзыв";
}

<div class="container">
    <h2>Оставить отзыв</h2>

    @if (Model.TimeSlot != null)
    {
        <div class="slot-info">
            <h4>Общение с: @Model.TimeSlot.VolunteerName</h4>
            <p>Дата: @Model.TimeSlot.SlotDateTime.ToString("dd.MM.yyyy HH:mm")</p>
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Review.TimeSlotId" />

        <div class="form-group">
            <label>Оценка:</label>
            <div class="rating-stars">
                @for (int i = 1; i <= 5; i++)
                {
                    <label>
                        <input type="radio" asp-for="Review.Rating" value="@i" />
                        <span class="star">⭐</span>
                    </label>
                }
            </div>
            <span asp-validation-for="Review.Rating" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Review.Comment">Ваш отзыв:</label>
            <textarea asp-for="Review.Comment" class="form-control" rows="4" placeholder="Расскажите о вашем опыте общения..."></textarea>
            <span asp-validation-for="Review.Comment" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Review.Author">Ваше имя:</label>
            <input asp-for="Review.Author" class="form-control" placeholder="Как к вам обращаться?" />
            <span asp-validation-for="Review.Author" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Отправить отзыв</button>
        <a href="/Slots" class="btn btn-secondary">Назад к списку</a>
    </form>
</div>